# Infrastructure credentials for local development.
# Copy to `infra/.env` — that file is gitignored.
#
# These are throwaway local-only values. Never reuse them anywhere real.

POSTGRES_USER=myblog
POSTGRES_PASSWORD=myblog_local_dev
POSTGRES_DB=myblog
POSTGRES_PORT=5432

REDIS_PORT=6379

# --- MinIO (SPIKE-E / F: local object storage) ---
# Dev-only throwaway credentials for the local MinIO container.
# PRODUCTION MUST NOT REUSE THESE VALUES: they are published in the repo as
# placeholders, and MINIO_ROOT_USER / MINIO_ROOT_PASSWORD are the S3 root
# access key / secret key — holding them means full write access to every
# bucket. Supply real ones out-of-band (S8 deploy manifest) instead.
MINIO_ROOT_USER=myblog_media
MINIO_ROOT_PASSWORD=replace-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MEDIA_BUCKET=portal-media
# The exact Origin string the browser sends. Must match the dev server
# origin byte-for-byte (see design §5: use localhost, never 127.0.0.1).
MINIO_CORS_ALLOW_ORIGIN=http://localhost:5175
