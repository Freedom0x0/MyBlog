# Copy to `apps/api/.env` — that file is gitignored.
#
# Values must match infra/.env, which is where the Postgres and Redis
# containers get their credentials from.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://myblog:myblog_local_dev@localhost:5432/myblog
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# ── S2 authentication ────────────────────────────────────────────────────────
# ≥32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must NOT be prefixed VITE_/NEXT_PUBLIC_: anything with those prefixes is inlined
# into the browser bundle, which would publish this secret.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Point at github.com in production; tests override this to a local stub.
OAUTH_BASE_URL=https://github.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_PATH=/api/v1/auth/github/callback

# Single explicit value. CORS with credentials:true forbids '*' — the browser
# rejects that combination, and it would let any site send session cookies.
PORTAL_WEB_ORIGIN=http://localhost:5175

# false only for local http dev; must be true anywhere cookies cross a real network
COOKIE_SECURE=false
API_PUBLIC_URL=http://localhost:3001

# ── S3 stage F: media object storage (MinIO) ─────────────────────────────────
# The five keys below are REQUIRED by the env schema, which makes them a CI
# contract as well as a local one — see the note in src/config/index.ts and the
# `env:` block in .github/workflows/ci.yml.
#
# Credentials come from infra/.env (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD); the
# bucket name is MINIO_MEDIA_BUCKET there. Nothing here may be a VITE_/NEXT_PUBLIC_
# value: MEDIA_SECRET_ACCESS_KEY is a signing key for writes.
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=portal-media
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# What a browser loads an <img> from. Separate from MEDIA_ENDPOINT on purpose: in
# production the API signs against a private endpoint while visitors go through a
# CDN, and `publicUrl` is built from THIS value only.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/portal-media

# Optional, defaults shown.
MEDIA_REGION=us-east-1
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_PRESIGN_TTL_SECONDS=60
