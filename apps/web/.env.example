# Copy to apps/web/.env

# Portal API (apps/api). Leave unset to use the http://localhost:3001/api/v1 default.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Still required for GitHub sign-in and for writing articles/comments.
# Browsing works without them; clicking login does not.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
