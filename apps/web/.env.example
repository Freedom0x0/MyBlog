# Copy to apps/web/.env

# Portal API (apps/api). Leave unset to use the http://localhost:3001/api/v1 default.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# That is the whole list. Sign-in and every write go through the portal API now,
# so the browser holds no third-party key: GitHub OAuth starts and ends on the API
# and the session lives in an HttpOnly cookie the SPA cannot read (and therefore
# cannot mis-declare here).
