{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nodenext, matching the API consumer: this package is imported by Node code
    // as well as bundled by Vite, so it must emit faithful ESM.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false
  },
  "include": ["src"]
}
